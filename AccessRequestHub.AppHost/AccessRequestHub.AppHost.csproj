<Project Sdk="Aspire.AppHost.Sdk/13.1.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AccessRequestHub.AppHost</RootNamespace>
    <UserSecretsId>AccessRequestHub-AppHost-Development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Alias metadata dipakai Program.cs untuk Projects.Backend dan Projects.IdentityServer. -->
    <ProjectReference Include="../AccessRequestHub.Web/AccessRequestHub.Web.csproj" AspireProjectMetadataTypeName="Backend" />
    <ProjectReference Include="../AccessRequestHub.IdentityServer/AccessRequestHub.IdentityServer.csproj" AspireProjectMetadataTypeName="IdentityServer" />
  </ItemGroup>
</Project>
