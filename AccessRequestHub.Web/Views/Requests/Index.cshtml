@model List<AccessRequest>
@{
    ViewData["Title"] = "My Requests";
    var flash = TempData["Flash"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">My Requests</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">Ajukan Request</a>
</div>

@if (!string.IsNullOrEmpty(flash))
{
    <div class="alert alert-success">@flash</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Belum ada request. Klik <strong>Ajukan Request</strong> untuk membuat yang pertama.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Environment</th>
                    <th>Access</th>
                    <th>Status</th>
                    <th>Version</th>
                    <th>Diajukan</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Application.Name</td>
                        <td>@item.Environment</td>
                        <td>@item.AccessLevel</td>
                        <td>
                            <partial name="_StatusBadge" model="item.Status" />
                            @if (item.IsHighRisk)
                            {
                                <span class="badge bg-danger">High-risk</span>
                            }
                        </td>
                        <td>@item.Version</td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Details" asp-route-id="@item.Id">Detail</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
