@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject AccessRequestHub.Persistence.Repository.AppDbContext NavigationDb
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var displayName = User?.FindFirstValue("name")
        ?? User?.FindFirstValue(ClaimTypes.Name)
        ?? User?.Identity?.Name
        ?? User?.FindFirstValue("email")
        ?? "Pengguna";

    // Gunakan identitas domain dari hasil autentikasi, bukan email atau ID hard-coded.
    var localUserId = User?.FindFirstValue("arh_user_id");
    var canRequest = false;
    var canApprove = false;
    var isAdmin = false;
    var isManager = false;
    var isSystemOwner = false;

    if (isAuthenticated && int.TryParse(localUserId, out var actorId))
    {
        // Proyeksi langsung menghindari navigation collection yang belum dimuat.
        var actor = await NavigationDb.Users.AsNoTracking()
            .Where(item => item.Id == actorId)
            .Select(item => new
            {
                item.DisplayName,
                item.ManagerId,
                item.IsAuditor,
                IsManager = item.DirectReports.Any(),
                IsSystemOwner = item.OwnedApplications.Any()
            })
            .SingleOrDefaultAsync(Context.RequestAborted);

        if (actor is not null)
        {
            displayName = actor.DisplayName;
            // D-11: hanya pengguna dengan atasan yang dapat membuat request.
            canRequest = actor.ManagerId.HasValue;
            isAdmin = actor.IsAuditor;
            isManager = actor.IsManager;
            isSystemOwner = actor.IsSystemOwner;
            // Auditor bukan approver otomatis; penugasan domain menentukan kemampuan.
            canApprove = isManager || isSystemOwner;
        }
    }

    var roleLabels = new System.Collections.Generic.List<string>();
    if (canRequest) roleLabels.Add("Requester");
    if (isManager) roleLabels.Add("Manager");
    if (isSystemOwner) roleLabels.Add("System Owner");
    if (isAdmin) roleLabels.Add("Admin / Auditor");
    var roleLabel = roleLabels.Count > 0
        ? string.Join(" / ", roleLabels)
        : "Akses belum tersedia";

    var homeController = !isAuthenticated ? "Account"
        : canApprove ? "Approvals"
        : isAdmin || canRequest ? "Requests" : "Home";
    var homeAction = !isAuthenticated ? "Login"
        : canApprove ? "Index"
        : isAdmin ? "All"
        : canRequest ? "Index" : "Forbidden";
}
<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Access Request Hub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AccessRequestHub.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="@homeController" asp-action="@homeAction">Access Request Hub</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* Navigasi hanya mencerminkan hak akses. Controller/service tetap memvalidasi authorization. *@
                        @if (canRequest)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Requests" asp-action="Index">My Requests</a>
                            </li>
                        }
                        @if (canApprove)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Approvals" asp-action="Index">Approval
                                    Inbox</a>
                                </li>
                            }
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Requests" asp-action="All">All Requests</a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="navbar-text me-3">
                                    @if (isAuthenticated)
                                    {
                                        <text>Aktif sebagai <strong>@displayName</strong> <span
                                            class="badge bg-secondary ms-1">@roleLabel</span></text>
                                        }
                                else
                                        {
                                            <text>Belum login</text>
                                        }
                                    </span>
                                </li>
                                <li class="nav-item">
                                    @if (isAuthenticated)
                                    {
                                        <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-link nav-link text-dark">Keluar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Masuk</a>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2026 - Access Request Hub
                </div>
            </footer>
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>