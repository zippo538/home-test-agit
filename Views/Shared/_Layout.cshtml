@using System.Security.Claims
@{
    var user = User;
    var isAuthenticated = user?.Identity?.IsAuthenticated == true;
    var displayName = user?.FindFirstValue("name")
        ?? user?.FindFirstValue(ClaimTypes.Name)
        ?? user?.Identity?.Name
        ?? user?.FindFirstValue("email")
        ?? "Pengguna";

    // Admin/Auditor memiliki navigasi baca seluruh request, bukan approval.
    var isAdmin = isAuthenticated && User.IsInRole("Admin");
    var isManager = isAuthenticated && User.IsInRole("Manager");
    var isSystemOwner = isAuthenticated && User.IsInRole("SystemOwner");
    var canRequest = isAuthenticated && User.IsInRole("Requester") && !isAdmin;
    var canApprove = (isManager || isSystemOwner) && !isAdmin;
    var homeController = isAuthenticated ? (isAdmin ? "Requests" : (canApprove ? "Approvals" : "Requests")) : "Account";
    var homeAction = isAuthenticated ? (isAdmin ? "All" : "Index") : "Login";
    var roleLabel = isAdmin ? "Admin / Auditor"
        : isManager && isSystemOwner ? "Manager / System Owner"
        : isManager ? "Manager"
        : isSystemOwner ? "System Owner"
        : canRequest ? "Requester" : "Tanpa peran";
}
<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Access Request Hub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/home_test_agit.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="@homeController" asp-action="@homeAction">Access Request Hub</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* Navigasi hanya mencerminkan hak akses. Controller/service tetap memvalidasi authorization. *@
                        @if (canRequest)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Requests" asp-action="Index">My Requests</a>
                            </li>
                        }
                        @if (canApprove)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Approvals" asp-action="Index">Approval
                                    Inbox</a>
                                </li>
                            }
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Requests" asp-action="All">All Requests</a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="navbar-text me-3">
                                    @if (isAuthenticated)
                                    {
                                        <text>Aktif sebagai <strong>@displayName</strong> <span
                                            class="badge bg-secondary ms-1">@roleLabel</span></text>
                                        }
                                else
                                        {
                                            <text>Belum login</text>
                                        }
                                    </span>
                                </li>
                                <li class="nav-item">
                                    @if (isAuthenticated)
                                    {
                                        <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-link nav-link text-dark">Keluar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Masuk</a>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2026 - Access Request Hub
                </div>
            </footer>
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>