@model SwitchUserViewModel
@{
    ViewData["Title"] = "Pilih User";
}

<h1 class="h4 mb-3">Pilih User (login simulasi)</h1>
<p class="text-muted">
    Phase 1 tidak memakai SSO. Pilih salah satu demo user untuk melanjutkan.
</p>

<div class="row g-3">
    @foreach (var user in Model.Users)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h2 class="h6 card-title mb-1">@user.DisplayName</h2>
                    <p class="text-muted small mb-3">@user.Email</p>
                    <form method="post" asp-action="Switch" class="mt-auto">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.Id" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-primary btn-sm">Masuk sebagai @user.DisplayName</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
