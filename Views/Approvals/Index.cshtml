@model List<AccessRequest>
@{
    ViewData["Title"] = "Approval Inbox";
}

<h1 class="h4 mb-3">Approval Inbox</h1>
<p class="text-muted small">
    Berisi request yang menunggu Anda: direct report Anda (tahap Manager) atau
    aplikasi yang Anda miliki (tahap System Owner).
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Tidak ada request yang menunggu Anda.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Requester</th>
                    <th>Application</th>
                    <th>Environment</th>
                    <th>Access</th>
                    <th>Tahap</th>
                    <th>Diajukan</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Requester.DisplayName</td>
                        <td>@item.Application.Name</td>
                        <td>@item.Environment</td>
                        <td>@item.AccessLevel</td>
                        <td>
                            <span class="badge bg-warning text-dark">@item.Status</span>
                            @if (item.IsHighRisk)
                            {
                                <span class="badge bg-danger">High-risk</span>
                            }
                        </td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-controller="Requests" asp-action="Details" asp-route-id="@item.Id">
                                Tinjau
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
